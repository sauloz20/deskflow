generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  REQUESTER
  AGENT
  MANAGER
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_REQUESTER
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  timezone    String       @default("America/Sao_Paulo")
  memberships Membership[]
  teams       Team[]
  categories  Category[]
  tickets     Ticket[]
  auditEvents AuditEvent[]
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  memberships  Membership[]
}

model Membership {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           Role
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  requested      Ticket[]     @relation("Requester")
  assigned       Ticket[]     @relation("Assignee")
  comments       Comment[]
  auditEvents    AuditEvent[]
  teams          TeamMember[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
}

model Team {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id])
  members        TeamMember[]
  tickets        Ticket[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
}

model TeamMember {
  organizationId String
  teamId         String
  membershipId   String
  team           Team       @relation(fields: [organizationId, teamId], references: [organizationId, id])
  membership     Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id])

  @@id([organizationId, teamId, membershipId])
}

model Category {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id])
  tickets        Ticket[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
}

model Ticket {
  id                String       @id @default(uuid())
  organizationId    String
  protocol          Int
  title             String
  description       String
  status            TicketStatus @default(OPEN)
  priority          Priority     @default(MEDIUM)
  requesterId       String
  assigneeId        String?
  categoryId        String
  teamId            String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
  organization      Organization @relation(fields: [organizationId], references: [id])
  requester         Membership   @relation("Requester", fields: [organizationId, requesterId], references: [organizationId, id], onDelete: Restrict)
  assignee          Membership?  @relation("Assignee", fields: [organizationId, assigneeId], references: [organizationId, id], onDelete: Restrict)
  category          Category     @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  team              Team?        @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Restrict)
  comments          Comment[]
  auditEvents       AuditEvent[]

  @@unique([organizationId, protocol])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, assigneeId])
}

model Comment {
  id             String            @id @default(uuid())
  organizationId String
  ticketId       String
  authorId       String
  body           String
  visibility     CommentVisibility @default(PUBLIC)
  createdAt      DateTime          @default(now())
  ticket         Ticket            @relation(fields: [organizationId, ticketId], references: [organizationId, id])
  author         Membership        @relation(fields: [organizationId, authorId], references: [organizationId, id])

  @@index([organizationId, ticketId, createdAt])
}

model AuditEvent {
  id             String       @id @default(uuid())
  organizationId String
  actorId        String
  ticketId       String?
  action         String
  changes        Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  actor          Membership   @relation(fields: [organizationId, actorId], references: [organizationId, id], onDelete: Restrict)
  ticket         Ticket?      @relation(fields: [organizationId, ticketId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, ticketId, createdAt])
}
